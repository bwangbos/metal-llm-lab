+static bool ggml_metal_try_moe_combine_fusion(
+        ggml_metal_op_t ctx,
+        int idx,
+        ggml_metal_moe_combine_fusion & fusion) {
+    const ggml_tensor * mul = ctx->node(idx);
+    if (mul->op != GGML_OP_MUL || mul->type != GGML_TYPE_F32) {
+        return false;
+    }
