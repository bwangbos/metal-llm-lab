+// ggml_qwen4exp_hc_reduce
+
+struct ggml_tensor * ggml_qwen4exp_hc_reduce(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * x,
+        struct ggml_tensor  * gate) {
+    GGML_ASSERT(x->type == GGML_TYPE_F32);
+    GGML_ASSERT(gate->type == GGML_TYPE_F32);
+    GGML_ASSERT(x->ne[1] > 0);
+    GGML_ASSERT(x->ne[3] == 1);
+    for (int i = 0; i < GGML_MAX_DIMS; ++i) {
+        GGML_ASSERT(x->ne[i] == gate->ne[i]);
+    }
+
+    struct ggml_tensor * result = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, x->ne[0], x->ne[2]);
+
+    result->op     = GGML_OP_QWEN4EXP_HC_REDUCE;
+    result->src[0] = x;
+    result->src[1] = gate;
+
+    return result;
+}
+
+// ggml_qwen4exp_hc_combine
+
+struct ggml_tensor * ggml_qwen4exp_hc_combine(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * residual,
+        struct ggml_tensor  * x,
+        struct ggml_tensor  * injection) {
+    GGML_ASSERT(residual->type == GGML_TYPE_F32);
+    GGML_ASSERT(x->type == GGML_TYPE_F32);
+    GGML_ASSERT(injection->type == GGML_TYPE_F32);
+
+    const int64_t n_embd   = residual->ne[0];
+    const int64_t hc       = residual->ne[1];
+    const int64_t n_tokens = residual->ne[2];
+
+    GGML_ASSERT(hc > 0);
+    GGML_ASSERT(residual->ne[3] == 1);
+    GGML_ASSERT(x->ne[0] == n_embd);
+    GGML_ASSERT(x->ne[1] == n_tokens);
+    GGML_ASSERT(x->ne[2] == 1);
+    GGML_ASSERT(x->ne[3] == 1);
+    GGML_ASSERT(injection->ne[0] == hc);
+    GGML_ASSERT(injection->ne[1] == n_tokens);
+    GGML_ASSERT(injection->ne[2] == 1);
+    GGML_ASSERT(injection->ne[3] == 1);
+
+    struct ggml_tensor * result = ggml_new_tensor_3d(ctx, GGML_TYPE_F32, n_embd, hc, n_tokens);
+
+    result->op     = GGML_OP_QWEN4EXP_HC_COMBINE;
+    result->src[0] = residual;
+    result->src[1] = x;
+    result->src[2] = injection;
+
+    return result;
+}
+
+// ggml_qsa_block_score
+
+struct ggml_tensor * ggml_qsa_block_score(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * q,
+        struct ggml_tensor  * k,
+        struct ggml_tensor  * cells,
+        struct ggml_tensor  * mask,
+        float                 scale) {
+    GGML_ASSERT(q->type == GGML_TYPE_F32);
+    GGML_ASSERT(k->type == GGML_TYPE_F32);
+    GGML_ASSERT(cells->type == GGML_TYPE_I32);
+    GGML_ASSERT(mask->type == GGML_TYPE_F32);
+    GGML_ASSERT(q->ne[0] == k->ne[0]);
+    GGML_ASSERT(k->ne[2] == 1 && k->ne[3] == 1);
+    GGML_ASSERT(cells->ne[0] == mask->ne[0]);
+    GGML_ASSERT(cells->ne[1] == 1 || cells->ne[1] == q->ne[2]);
+    GGML_ASSERT(mask->ne[1] == q->ne[2]);
+    GGML_ASSERT(cells->ne[2] == 1 && mask->ne[2] == 1);
+    GGML_ASSERT(cells->ne[3] == q->ne[3]);
+    GGML_ASSERT(cells->ne[3] == mask->ne[3]);
+    GGML_ASSERT(ggml_is_contiguous_rows(q));
+    GGML_ASSERT(ggml_is_contiguous_rows(k));
+    GGML_ASSERT(ggml_is_contiguous(cells));
+    GGML_ASSERT(ggml_is_contiguous(mask));
+
+    struct ggml_tensor * result = ggml_new_tensor_4d(
+            ctx, GGML_TYPE_F32, cells->ne[0], q->ne[2], 1, q->ne[3]);
+
+    result->op     = GGML_OP_QSA_BLOCK_SCORE;
+    result->src[0] = q;
+    result->src[1] = k;
+    result->src[2] = cells;
+    result->src[3] = mask;
+
+    ggml_set_op_params_f32(result, 0, scale);
+
+    return result;
+}
