diff --git a/tests/test-server-speculative.cpp b/tests/test-server-speculative.cpp
new file mode 100644
index 0000000..7fbbfa9
--- /dev/null
+++ b/tests/test-server-speculative.cpp
@@ -0,0 +1,173 @@
+#include "arg.h"
+#include "common.h"
+#include "server-common.h"
+#include "server-context.h"
+#include "server-task.h"
+
+#include <string>
+#include <vector>
+
+#undef NDEBUG
+#include <cassert>
+
+static bool parse_server(std::vector<std::string> args, common_params & params) {
+    std::vector<char *> argv;
+    argv.reserve(args.size());
+    for (auto & arg : args) {
+        argv.push_back(arg.data());
+    }
+    return common_params_parse((int) argv.size(), argv.data(), params, LLAMA_EXAMPLE_SERVER);
+}
+
+static void test_max_prompt_tokens_option() {
+    {
+        common_params params;
+        assert(params.speculative.max_prompt_tokens == -1);
+    }
+
+    {
+        common_params params;
+        assert(parse_server({
+            "llama-server",
+            "--spec-draft-max-prompt-tokens", "32768",
+            "--spec-draft-model", "draft.gguf",
+        }, params));
+        assert(params.speculative.max_prompt_tokens == 32768);
+    }
+
+    {
+        common_params params;
+        assert(parse_server({
+            "llama-server",
+            "--spec-draft-max-prompt-tokens", "32768",
+            "--spec-type", "draft-mtp",
+        }, params));
+        assert(params.speculative.max_prompt_tokens == 32768);
+        assert(params.speculative.has_mtp());
+    }
+
+    for (const char * value : {"-1", "0"}) {
+        common_params params;
+        assert(!parse_server({
+            "llama-server",
+            "--spec-draft-model", "draft.gguf",
+            "--spec-draft-max-prompt-tokens", value,
+        }, params));
+    }
+
+    {
+        common_params params;
+        assert(!parse_server({
+            "llama-server",
+            "--spec-draft-max-prompt-tokens", "32768",
+        }, params));
+    }
+}
+
+static server_slot_stats stats_for(const server_speculative_route & route, bool speculative_loaded) {
+    server_slot_stats stats;
+    route.apply_to(stats, speculative_loaded);
+    return stats;
+}
+
+static void test_effective_prompt_boundaries() {
+    for (const auto & test : std::vector<std::pair<int32_t, bool>> {
+            {32767, true},
+            {32768, true},
+            {32769, false},
+        }) {
+        server_speculative_route route;
+        route.begin(true, 32768, test.first);
+
+        assert(route.enabled(true) == test.second);
+        assert(route.effective_prompt_tokens == test.first);
+        assert(route.speculative_threshold == 32768);
+
+        const auto timing = stats_for(route, true).to_json();
+        assert(timing.at("speculative") == test.second);
+        assert(timing.at("speculative_policy") == "dynamic");
+        assert(timing.at("effective_prompt_tokens") == test.first);
+        assert(timing.at("speculative_threshold") == 32768);
+    }
+}
+
+static void test_fixed_policies_and_reset() {
+    server_speculative_route fixed_on;
+    fixed_on.begin(true, -1, 12);
+    const auto on_timing = stats_for(fixed_on, true).to_json();
+    assert(fixed_on.enabled(true));
+    assert(on_timing.at("speculative") == true);
+    assert(on_timing.at("speculative_policy") == "on");
+    assert(on_timing.at("effective_prompt_tokens") == 12);
+    assert(on_timing.at("speculative_threshold").is_null());
+
+    server_speculative_route fixed_off;
+    fixed_off.begin(false, 32768, 99);
+    const auto off_timing = stats_for(fixed_off, false).to_json();
+    assert(!fixed_off.enabled(false));
+    assert(off_timing.at("speculative") == false);
+    assert(off_timing.at("speculative_policy") == "off");
+    assert(off_timing.at("effective_prompt_tokens") == 99);
+    assert(off_timing.at("speculative_threshold").is_null());
+
+    fixed_off.reset();
+    assert(fixed_off.speculative_for_task);
+    assert(fixed_off.effective_prompt_tokens == 0);
+    assert(fixed_off.speculative_threshold == -1);
+}
+
+static void test_simultaneous_opposite_decisions_are_independent() {
+    server_speculative_route short_route;
+    server_speculative_route long_route;
+
+    short_route.begin(true, 32768, 32768);
+    long_route.begin(true, 32768, 32769);
+
+    assert(short_route.enabled(true));
+    assert(!long_route.enabled(true));
+    assert(!short_route.can_batch_with(long_route, true));
+
+    long_route.reset();
+    assert(short_route.enabled(true));
+    assert(long_route.speculative_for_task);
+    assert(short_route.can_batch_with(long_route, true));
+}
+
+static void test_prompt_cache_keeps_route_compatible_states_separate() {
+    server_prompt prompt;
+    prompt.speculative = true;
+
+    const auto clone = prompt.clone();
+    assert(clone.speculative);
+
+    server_prompt_cache cache(-1, 0);
+    assert(cache.alloc(prompt, 0, 0) != nullptr);
+
+    prompt.speculative = false;
+    assert(cache.alloc(prompt, 0, 0) != nullptr);
+    assert(cache.states.size() == 2);
+
+    prompt.clear();
+    assert(!prompt.speculative);
+}
+
+static void test_threshold_requires_successful_speculative_initialization() {
+    common_params_speculative params;
+    params.max_prompt_tokens = 32768;
+
+    assert(!server_speculative_init_is_valid(params, false));
+    assert(server_speculative_init_is_valid(params, true));
+
+    params.max_prompt_tokens = -1;
+    assert(server_speculative_init_is_valid(params, false));
+}
+
+int main() {
+    test_max_prompt_tokens_option();
+    test_effective_prompt_boundaries();
+    test_fixed_policies_and_reset();
+    test_simultaneous_opposite_decisions_are_independent();
+    test_prompt_cache_keeps_route_compatible_states_separate();
+    test_threshold_requires_successful_speculative_initialization();
+    return 0;
+}
