+void server_speculative_route::begin(bool speculative_loaded, int32_t threshold, int32_t prompt_tokens) {
+    effective_prompt_tokens = prompt_tokens;
+    speculative_threshold = threshold;
+    speculative_for_task = speculative_loaded && (threshold < 0 || prompt_tokens <= threshold);
+}
+
+void server_speculative_route::reset() {
+    speculative_for_task = true;
+    effective_prompt_tokens = 0;
+    speculative_threshold = -1;
+}
+
+bool server_speculative_route::enabled(bool speculative_loaded) const {
+    return speculative_loaded && speculative_for_task;
+}
+
+bool server_speculative_route::can_batch_with(const server_speculative_route & other, bool speculative_loaded) const {
+    return enabled(speculative_loaded) == other.enabled(speculative_loaded);
+}
+
+void server_speculative_route::apply_to(server_slot_stats & stats, bool speculative_loaded) const {
+    stats.speculative = enabled(speculative_loaded);
+    stats.effective_prompt_tokens = effective_prompt_tokens;
+    stats.speculative_threshold = speculative_loaded ? speculative_threshold : -1;
+    stats.speculative_policy = !speculative_loaded ? "off" : speculative_threshold < 0 ? "on" : "dynamic";
