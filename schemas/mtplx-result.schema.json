{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Managed MTPLX API benchmark result v3",
  "description": "Complete portable result shape; pin, suite, request, response, privacy, and settings cross-checks are enforced by mtplx_adapter.validate_result.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "experiment_id",
    "date",
    "model_id",
    "suite_id",
    "benchmark_mode",
    "provenance",
    "runs"
  ],
  "properties": {
    "schema_version": {
      "const": 3
    },
    "experiment_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+([.-][a-z0-9]+)*$"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "model_id": {
      "const": "qwen3.8-flash-next-mtplx"
    },
    "suite_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+([.-][a-z0-9]+)*$"
    },
    "benchmark_mode": {
      "const": "endpoint"
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "runs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/run"
      }
    }
  },
  "$defs": {
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "api_model_id",
        "runtime_id",
        "mtp_policy",
        "vision_control",
        "agent_rewrites",
        "prompt_path",
        "scheduler_mode",
        "ssd_session_cache",
        "fan_mode",
        "reasoning",
        "reasoning_effort",
        "preserve_thinking",
        "host",
        "chip",
        "memory_limit_source",
        "context",
        "mtp_depth",
        "max_active_requests",
        "top_k",
        "port",
        "unified_memory_bytes",
        "vision",
        "telemetry",
        "api_key_configured",
        "hardware_qualified",
        "temperature",
        "top_p",
        "memory_limit_bytes"
      ],
      "properties": {
        "profile_id": {
          "type": "string"
        },
        "api_model_id": {
          "type": "string"
        },
        "runtime_id": {
          "type": "string"
        },
        "mtp_policy": {
          "type": "string"
        },
        "vision_control": {
          "type": "string"
        },
        "agent_rewrites": {
          "type": "string"
        },
        "prompt_path": {
          "type": "string"
        },
        "scheduler_mode": {
          "type": "string"
        },
        "ssd_session_cache": {
          "type": "string"
        },
        "fan_mode": {
          "type": "string"
        },
        "reasoning": {
          "type": "string"
        },
        "reasoning_effort": {
          "type": "string"
        },
        "preserve_thinking": {
          "type": "string"
        },
        "host": {
          "type": "string"
        },
        "chip": {
          "type": "string"
        },
        "memory_limit_source": {
          "type": "string"
        },
        "context": {
          "type": "integer",
          "minimum": 0
        },
        "mtp_depth": {
          "type": "integer",
          "minimum": 0
        },
        "max_active_requests": {
          "type": "integer",
          "minimum": 0
        },
        "top_k": {
          "type": "integer",
          "minimum": 0
        },
        "port": {
          "type": "integer",
          "minimum": 0
        },
        "unified_memory_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "vision": {
          "type": "boolean"
        },
        "telemetry": {
          "type": "boolean"
        },
        "api_key_configured": {
          "type": "boolean"
        },
        "hardware_qualified": {
          "type": "boolean"
        },
        "temperature": {
          "type": "number",
          "minimum": 0
        },
        "top_p": {
          "type": "number",
          "minimum": 0
        },
        "memory_limit_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "lock_sha256",
        "manifest_sha256",
        "installation_receipt_sha256",
        "python_sha256",
        "adapter_sha256",
        "packages"
      ],
      "properties": {
        "id": {
          "const": "mtplx-2.11.2"
        },
        "version": {
          "const": "2.11.2"
        },
        "lock_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "installation_receipt_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "python_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "adapter_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "packages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "version"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z0-9]+([.-][a-z0-9]+)*$"
              },
              "version": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "artifact_verification": {
      "type": "object",
      "additionalProperties": false,
      "oneOf": [
        {"properties": {
          "requested_mode": {"const": "disabled"},
          "effective_mode": {"const": "disabled"},
          "cache_hits": {"const": 0}, "cache_misses": {"const": 0}, "full_hashes": {"const": 0},
          "receipt_set_sha256": {"type": "null"}
        }},
        {"properties": {
          "requested_mode": {"enum": ["cached", "full"]},
          "effective_mode": {"enum": ["cached", "full", "mixed"]},
          "receipt_set_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }}
      ],
      "required": [
        "requested_mode",
        "effective_mode",
        "cache_hits",
        "cache_misses",
        "full_hashes",
        "receipt_set_sha256"
      ],
      "properties": {
        "requested_mode": {
          "enum": [
            "full",
            "cached",
            "disabled"
          ]
        },
        "effective_mode": {
          "enum": [
            "full",
            "cached",
            "mixed",
            "disabled"
          ]
        },
        "cache_hits": {
          "type": "integer",
          "minimum": 0
        },
        "cache_misses": {
          "type": "integer",
          "minimum": 0
        },
        "full_hashes": {
          "type": "integer",
          "minimum": 0
        },
        "receipt_set_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "hardware",
        "system",
        "runtime",
        "configuration",
        "model_revision",
        "model_manifest_sha256",
        "artifacts",
        "artifact_verification",
        "suite"
      ],
      "properties": {
        "repository": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "revision",
            "tree_sha",
            "clean"
          ],
          "properties": {
            "revision": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            },
            "tree_sha": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            },
            "clean": {
              "const": true
            }
          }
        },
        "hardware": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "chip",
            "unified_memory_bytes"
          ],
          "properties": {
            "chip": {
              "type": "string"
            },
            "unified_memory_bytes": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "system": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operating_system",
            "operating_system_version"
          ],
          "properties": {
            "operating_system": {
              "const": "Darwin"
            },
            "operating_system_version": {
              "type": "string"
            }
          }
        },
        "runtime": {
          "$ref": "#/$defs/runtime"
        },
        "configuration": {
          "$ref": "#/$defs/configuration"
        },
        "model_revision": {
          "const": "6bc2f6e8426ccb4af73c81bc56ba7718afc92cc6"
        },
        "model_manifest_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "artifacts": {
          "type": "array",
          "minItems": 39,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "bytes",
              "sha256"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "bytes": {
                "type": "integer",
                "minimum": 0
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        },
        "artifact_verification": {
          "$ref": "#/$defs/artifact_verification"
        },
        "suite": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "sha256",
            "fixtures"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9]+([.-][a-z0-9]+)*$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "fixtures": {
              "type": "array",
              "minItems": 0,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "sha256"
                ],
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                }
              }
            }
          }
        }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "timestamp",
        "measurement_kind",
        "experiment",
        "request_kind",
        "profile_id",
        "runtime_alias",
        "runtime_id",
        "runtime_revision",
        "context",
        "vision",
        "mtp_policy",
        "mtp_threshold",
        "prompt_tokens",
        "generated_tokens",
        "prompt_tokens_per_second",
        "generation_tokens_per_second",
        "wall_seconds",
        "stream",
        "raw_response",
        "request_sha256",
        "generation_settings",
        "reasoning_settings",
        "prompt_path",
        "notes",
        "timings",
        "usage",
        "effective_prompt_tokens",
        "mtp_selected",
        "mtp_route_evidence",
        "output_sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+([.-][a-z0-9]+)*$"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "measurement_kind": {
          "const": "single_run"
        },
        "experiment": {
          "const": "suite-run"
        },
        "request_kind": {
          "enum": [
            "text",
            "vision"
          ]
        },
        "profile_id": {
          "enum": [
            "default",
            "custom"
          ]
        },
        "runtime_alias": {
          "const": "mtplx"
        },
        "runtime_id": {
          "const": "mtplx-2.11.2"
        },
        "runtime_revision": {
          "const": "2.11.2"
        },
        "context": {
          "type": "integer",
          "minimum": 1,
          "maximum": 262144
        },
        "vision": {
          "type": "boolean"
        },
        "mtp_policy": {
          "enum": [
            "on",
            "off"
          ]
        },
        "mtp_threshold": {
          "type": "null"
        },
        "prompt_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "generated_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "prompt_tokens_per_second": {
          "type": "number",
          "minimum": 0
        },
        "generation_tokens_per_second": {
          "type": "number",
          "minimum": 0
        },
        "wall_seconds": {
          "type": "number",
          "minimum": 0
        },
        "stream": {
          "type": "boolean"
        },
        "raw_response": {
          "type": "string"
        },
        "request_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "generation_settings": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "max_tokens",
            "temperature",
            "top_p",
            "top_k",
            "seed"
          ],
          "properties": {
            "max_tokens": {
              "type": "integer",
              "minimum": 1
            },
            "temperature": {
              "type": "number",
              "minimum": 0
            },
            "top_p": {
              "type": "number",
              "minimum": 0
            },
            "top_k": {
              "type": "integer",
              "minimum": 0
            },
            "seed": {
              "type": "integer"
            }
          }
        },
        "reasoning_settings": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reasoning",
            "reasoning_effort",
            "preserve_thinking"
          ],
          "properties": {
            "reasoning": {
              "const": "on"
            },
            "reasoning_effort": {
              "const": "xhigh"
            },
            "preserve_thinking": {
              "const": "on"
            }
          }
        },
        "prompt_path": {
          "const": "native"
        },
        "notes": {
          "type": "string"
        },
        "timings": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "prompt_n",
            "predicted_n",
            "prompt_ms",
            "predicted_ms",
            "prompt_per_second",
            "predicted_per_second",
            "draft_n",
            "draft_n_accepted"
          ],
          "properties": {
            "prompt_n": {
              "type": "integer",
              "minimum": 0
            },
            "predicted_n": {
              "type": "integer",
              "minimum": 0
            },
            "prompt_ms": {
              "type": "number",
              "minimum": 0
            },
            "predicted_ms": {
              "type": "number",
              "minimum": 0
            },
            "prompt_per_second": {
              "type": "number",
              "minimum": 0
            },
            "predicted_per_second": {
              "type": "number",
              "minimum": 0
            },
            "draft_n": {
              "type": "integer",
              "minimum": 0
            },
            "draft_n_accepted": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "usage": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "prompt_tokens",
            "completion_tokens"
          ],
          "properties": {
            "prompt_tokens": {
              "type": "integer",
              "minimum": 0
            },
            "completion_tokens": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "effective_prompt_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "mtp_selected": {
          "type": "boolean"
        },
        "mtp_route_evidence": {
          "const": "response.timings.draft_n"
        },
        "output_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}
