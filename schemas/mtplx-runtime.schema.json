{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Managed wheel runtime manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "runtime_type",
    "version",
    "repository",
    "license",
    "python",
    "platform",
    "lock",
    "lock_sha256",
    "packages",
    "capabilities"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "id": {
      "const": "mtplx-2.11.2"
    },
    "runtime_type": {
      "const": "mtplx"
    },
    "version": {
      "const": "2.11.2"
    },
    "repository": {
      "const": "https://github.com/youssofal/mtplx"
    },
    "license": {
      "const": "Apache-2.0"
    },
    "python": {
      "const": "3.12"
    },
    "platform": {
      "const": "macos-arm64"
    },
    "lock": {
      "const": "manifests/locks/mtplx-2.11.2-macos-arm64-py312.txt"
    },
    "lock_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "packages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "version"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9]+([.-][a-z0-9]+)*$"
          },
          "version": {
            "type": "string"
          }
        }
      }
    },
    "capabilities": {
      "const": {
        "serve": true,
        "api_bench": true,
        "local_bench": false
      }
    }
  }
}
