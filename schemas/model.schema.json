{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metal-llm-lab.dev/schemas/model.schema.json",
  "title": "Metal LLM Lab model manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "id", "name", "artifacts", "default_profile", "max_context",
    "runtime_aliases", "text_model", "capabilities", "metal", "profiles"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "id": { "$ref": "#/$defs/id" },
    "name": { "type": "string", "minLength": 1 },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/artifact" }
    },
    "default_profile": { "$ref": "#/$defs/id" },
    "max_context": { "type": "integer", "minimum": 1 },
    "runtime_aliases": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tuned", "upstream"],
      "properties": {
        "tuned": { "$ref": "#/$defs/id" },
        "upstream": { "$ref": "#/$defs/id" }
      }
    },
    "text_model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entry_artifact_id", "artifact_ids", "total_bytes"],
      "properties": {
        "entry_artifact_id": { "$ref": "#/$defs/id" },
        "artifact_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "total_bytes": { "type": "integer", "minimum": 1 }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vision", "mtp"],
      "properties": {
        "vision": { "$ref": "#/$defs/vision_capability" },
        "mtp": { "$ref": "#/$defs/mtp_capability" }
      }
    },
    "metal": { "$ref": "#/$defs/metal" },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/profile" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "filename", "url", "bytes", "sha256", "license_url"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["model", "projector", "mtp"] },
        "filename": { "type": "string", "pattern": "^[^/]+$" },
        "url": { "type": "string", "format": "uri", "minLength": 1 },
        "bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "license_url": { "type": "string", "format": "uri", "minLength": 1 }
      }
    },
    "vision_capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default_enabled", "projector_artifact_id", "image_min_tokens"],
      "properties": {
        "default_enabled": { "type": "boolean" },
        "projector_artifact_id": { "$ref": "#/$defs/id" },
        "image_min_tokens": { "type": "integer", "minimum": 1 }
      }
    },
    "mtp_capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "spec_type", "draft_n_max", "gpu_layers", "dynamic_threshold"],
      "properties": {
        "artifact_id": { "$ref": "#/$defs/id" },
        "spec_type": { "const": "draft-mtp" },
        "draft_n_max": { "type": "integer", "minimum": 1 },
        "gpu_layers": { "const": "all" },
        "dynamic_threshold": { "type": "integer", "minimum": 1 }
      }
    },
    "metal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gpu_layers", "fit", "flash_attention", "load_mode", "lazy_mmap"],
      "properties": {
        "gpu_layers": { "const": "all" },
        "fit": { "const": false },
        "flash_attention": { "const": true },
        "load_mode": { "const": "mmap" },
        "lazy_mmap": { "const": true }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "runtime", "context", "mtp_policy", "status"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "runtime": { "enum": ["tuned", "upstream"] },
        "context": { "type": "integer", "minimum": 1 },
        "mtp_policy": { "enum": ["on", "off", "dynamic"] },
        "status": { "enum": ["supported", "pending-acceptance", "recommended", "reference"] }
      },
      "allOf": [
        {
          "if": { "properties": { "runtime": { "const": "upstream" } } },
          "then": { "properties": { "mtp_policy": { "const": "off" } } }
        },
        {
          "if": { "properties": { "mtp_policy": { "enum": ["on", "dynamic"] } } },
          "then": { "properties": { "runtime": { "const": "tuned" } } }
        }
      ]
    }
  }
}
