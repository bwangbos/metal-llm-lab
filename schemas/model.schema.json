{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metal-llm-lab.dev/schemas/model.schema.json",
  "title": "Metal LLM Lab model manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "name", "artifacts", "text_model", "profiles"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "$ref": "#/$defs/id" },
    "name": { "type": "string", "minLength": 1 },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/artifact" }
    },
    "text_model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_ids", "total_bytes"],
      "properties": {
        "artifact_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "total_bytes": { "type": "integer", "minimum": 1 }
      }
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/profile" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "filename", "url", "bytes", "sha256", "license_url"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["model", "projector", "mtp"] },
        "filename": { "type": "string", "pattern": "^[^/]+$" },
        "url": { "type": "string", "format": "uri", "minLength": 1 },
        "bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "license_url": { "type": "string", "format": "uri", "minLength": 1 }
      }
    },
    "metal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gpu_layers", "fit", "flash_attention", "load_mode", "lazy_mmap"],
      "properties": {
        "gpu_layers": { "const": "all" },
        "fit": { "const": false },
        "flash_attention": { "const": true },
        "load_mode": { "const": "mmap" },
        "lazy_mmap": { "const": true }
      }
    },
    "vision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "projector_artifact_id", "image_min_tokens"],
      "properties": {
        "enabled": { "type": "boolean" },
        "projector_artifact_id": { "type": ["string", "null"] },
        "image_min_tokens": { "type": ["integer", "null"], "minimum": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "enabled": { "const": true } } },
          "then": {
            "properties": {
              "projector_artifact_id": { "$ref": "#/$defs/id" },
              "image_min_tokens": { "type": "integer", "minimum": 1 }
            }
          },
          "else": {
            "properties": {
              "projector_artifact_id": { "type": "null" },
              "image_min_tokens": { "type": "null" }
            }
          }
        }
      ]
    },
    "mtp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "artifact_id", "spec_type", "draft_n_max", "gpu_layers"],
      "properties": {
        "enabled": { "type": "boolean" },
        "artifact_id": { "type": ["string", "null"] },
        "spec_type": { "type": ["string", "null"] },
        "draft_n_max": { "type": ["integer", "null"], "minimum": 1 },
        "gpu_layers": { "type": ["string", "null"] }
      },
      "allOf": [
        {
          "if": { "properties": { "enabled": { "const": true } } },
          "then": {
            "properties": {
              "artifact_id": { "$ref": "#/$defs/id" },
              "spec_type": { "type": "string", "minLength": 1 },
              "draft_n_max": { "type": "integer", "minimum": 1 },
              "gpu_layers": { "const": "all" }
            }
          },
          "else": {
            "properties": {
              "artifact_id": { "type": "null" },
              "spec_type": { "type": "null" },
              "draft_n_max": { "type": "null" },
              "gpu_layers": { "type": "null" }
            }
          }
        }
      ]
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "runtime_id", "model_artifact_id", "context", "vision", "mtp", "metal"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "runtime_id": { "$ref": "#/$defs/id" },
        "model_artifact_id": { "$ref": "#/$defs/id" },
        "context": { "type": "integer", "minimum": 1 },
        "vision": { "$ref": "#/$defs/vision" },
        "mtp": { "$ref": "#/$defs/mtp" },
        "metal": { "$ref": "#/$defs/metal" }
      }
    }
  }
}
