#!/bin/zsh
set -euo pipefail
setopt extended_glob

METAL_LLM_ROOT=${0:A:h:h}
export METAL_LLM_ROOT

source "$METAL_LLM_ROOT/lib/common.zsh"
source "$METAL_LLM_ROOT/lib/artifact-verification.zsh"
source "$METAL_LLM_ROOT/lib/doctor.zsh"
source "$METAL_LLM_ROOT/lib/profile.zsh"
source "$METAL_LLM_ROOT/lib/setup.zsh"
source "$METAL_LLM_ROOT/lib/runtime-state.zsh"
source "$METAL_LLM_ROOT/lib/managed-process.zsh"
source "$METAL_LLM_ROOT/lib/runtime-adapter.zsh"
source "$METAL_LLM_ROOT/lib/serve.zsh"
source "$METAL_LLM_ROOT/lib/bench.zsh"
source "$METAL_LLM_ROOT/lib/report.zsh"

metal_llm_help() {
    print -- 'usage: metal-llm COMMAND [ARGUMENTS]'
    print -- ''
    print -- 'commands:'
    print -- '  metal-llm doctor'
    print -- '  metal-llm setup MODEL [--artifact-check cached|full|disabled] [--dry-run] [--yes]'
    print -- '  metal-llm serve MODEL [--profile auto|fast|long|stable] [--vision on|off] [--artifact-check cached|full|disabled] [--dry-run] [-- EXTRA_LLAMA_ARGS]'
    print -- '  metal-llm serve MODEL --profile custom --runtime tuned|upstream --mtp on|off|dynamic --context TOKENS [--vision on|off] [--artifact-check cached|full|disabled] [--dry-run] [-- EXTRA_LLAMA_ARGS]'
    print -- '    serve defaults: --profile auto and model vision default'
    print -- '  MTPLX package: qwen3.8-flash-next-mtplx'
    print -- '    setup accepts --import-from DIRECTORY (verified copy; source unchanged)'
    print -- '    serve defaults to --profile default; custom requires --mtp on|off --context TOKENS'
    print -- '    serve accepts --vision on|off; MTPLX rejects --runtime, dynamic MTP and concurrency >1'
    print -- '    bench supports --mode endpoint only; no local llama-bench capability'
    print -- '  metal-llm bench MODEL --suite SUITE [--mode MODE] [--artifact-check cached|full|disabled] [--dry-run]'
    print -- '  metal-llm report [--check]'
    print -- '  metal-llm help'
    print -- ''
    print -- 'environment:'
    print -- '  METAL_LLM_BUILD_RESERVE_BYTES  build-space reserve for setup (default: 5368709120)'
    print -- '  METAL_LLM_HOST                 server bind address (default: 127.0.0.1)'
    print -- '  METAL_LLM_PORT                 server port (default: 8080)'
    print -- '  METAL_LLM_PARALLEL             request slots (default: 1)'
    print -- '  METAL_LLM_API_KEY              optional server API key (never logged)'
    print -- '  METAL_LLM_PYTHON               Python 3.12 executable for MTPLX environment setup'
    print -- '  MTPLX_MEMORY_LIMIT_BYTES       explicit MTPLX memory override; otherwise qualified 104 GiB or upstream default'
}

command_name=${1:-help}
(( $# == 0 )) || shift

if [[ "$command_name" == setup || "$command_name" == serve || "$command_name" == bench ]] && \
   [[ "${1:-}" == qwen3.8-flash-next-mtplx ]]; then
    shift
    metal_llm_mtplx "$command_name" "$@"
    exit $?
fi

case "$command_name" in
    help|-h|--help)
        (( $# == 0 )) || { metal_llm_error 'help does not accept arguments'; exit 2; }
        metal_llm_help
        ;;
    doctor) metal_llm_doctor "$@" ;;
    setup) metal_llm_setup "$@" ;;
    serve) metal_llm_serve "$@" ;;
    bench) metal_llm_bench "$@" ;;
    report) metal_llm_report "$@" ;;
    *)
        metal_llm_error "unknown command: $command_name"
        metal_llm_help >&2
        exit 2
        ;;
esac
